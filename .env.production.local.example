# Production migration credentials.
#
# Copy to .env.production.local (gitignored) and fill in. Used ONLY by the
# deliberate prod migration scripts, never by the app runtime or the dev server:
#   pnpm db:migrate:prod:status   # read-only — check what prod has applied
#   pnpm db:migrate:prod          # apply pending migrations to PRODUCTION
#
# DATABASE_URL must point at the PRODUCTION Neon branch (the same endpoint
# nemdb.com / Vercel uses), NOT development or e2e. Run :status first and
# eyeball the output before ever running the apply.

# Production Neon branch connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Required by env validation (migrate.ts loads the db client). Reuse prod values
# or any valid placeholder of the right shape — migrations do not use auth/APIs.
JWT_SECRET=
JWT_REFRESH_SECRET=
TMDB_API_KEY=
ABLY_API_KEY=
