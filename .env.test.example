# E2E Test Environment
# Copy to .env.test and fill in values.
# Use a SEPARATE database (e.g., Neon branch) — not your dev/prod DB.

# Database (Neon branch for testing)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Auth (any 32+ char strings — test-only)
JWT_SECRET=e2e-test-jwt-secret-that-is-at-least-32-characters
JWT_REFRESH_SECRET=e2e-test-refresh-secret-at-least-32-characters

# TMDB (same key as dev — needed for import tests)
TMDB_API_KEY=

# Ably (same key as dev, or a separate test key)
ABLY_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
