# ==========================================
# Core line endings: force LF for all text
# ==========================================
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.sh text eol=lf
.env* text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
*.eslintrc* text eol=lf
*.prettierrc* text eol=lf
next.config.* text eol=lf

# ==========================================
# Binary files: never modify line endings
# ==========================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.7z binary
*.rar binary

# ==========================================
# Generated files (ignored for linguist/stats)
# ==========================================
.next/** linguist-generated
build/** linguist-generated
coverage/** linguist-generated

# ==========================================
# Documentation
# ==========================================
docs/** linguist-documentation
*.md linguist-documentation
